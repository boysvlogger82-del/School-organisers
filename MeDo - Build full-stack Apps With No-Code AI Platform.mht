.Theme-ShadowEditor .trash-icon .common-icon path { fill: var(--colors-neutral-text-2); }

.Theme-ShadowEditor .trash-icon .common-icon:hover path { fill: var(--colors-brand-5); }

.Theme-ShadowEditor .trash-icon .disabled-icon { cursor: not-allowed; }

.Theme-ShadowEditor .trash-icon .disabled-icon path, .Theme-ShadowEditor .trash-icon .disabled-icon:hover path { fill: var(--colors-neutral-text-5); }

.Theme-ShadowEditor-view { align-items: center; background-color: rgb(255, 255, 255); background-image: linear-gradient(45deg, rgb(247, 248, 250) 25%, transparent 0px, transparent 75%, rgb(247, 248, 250) 0px, rgb(247, 248, 250)), linear-gradient(45deg, rgb(247, 248, 250) 25%, transparent 0px, transparent 75%, rgb(247, 248, 250) 0px, rgb(247, 248, 250)); background-position: 0px 0px, 5px 5px; background-size: 10px 10px; border: 1px solid rgba(150, 150, 150, 0.1); border-radius: 0.25rem; display: flex; height: 2rem; justify-content: center; margin-right: 0.25rem; overflow: hidden; width: 2.625rem; }

.Theme-ShadowEditor-view-inner { background: rgb(255, 255, 255); height: 1.25rem; width: 1.75rem; }

.Theme-ShadowView { font-size: 12px; padding: 0.75rem; width: 18.75rem; }

.Theme-ShadowView-header { color: rgb(5, 10, 16); font-weight: 500; line-height: 1.25rem; margin-bottom: 0.5rem; }

.Theme-ShadowView-body { border: 1px solid rgb(232, 233, 235); border-radius: 0.25rem; padding: 0.75rem; }

.Theme-ShadowView-body-shadow { align-items: center; background-color: rgb(255, 255, 255); background-image: linear-gradient(45deg, rgb(247, 248, 250) 25%, transparent 0px, transparent 75%, rgb(247, 248, 250) 0px, rgb(247, 248, 250)), linear-gradient(45deg, rgb(247, 248, 250) 25%, transparent 0px, transparent 75%, rgb(247, 248, 250) 0px, rgb(247, 248, 250)); background-position: 0px 0px, 10px 10px; background-size: 20px 20px; display: flex; height: 6.25rem; justify-content: center; overflow: hidden; width: 100%; }

.Theme-ShadowView-body-shadow-square { background: rgb(255, 255, 255); height: 4.375rem; width: 10.25rem; }

.Theme-ShadowView-body-title { color: rgb(5, 10, 16); font-size: 12px; font-weight: 500; line-height: 1.25rem; margin: 0.5rem 0px 0px; }

.Theme-ShadowView-body-value { color: rgb(131, 134, 140); line-height: 1.25rem; }

.cxd-PopOver { z-index: 1400 !important; }
