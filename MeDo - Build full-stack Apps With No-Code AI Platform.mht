.rdt { position: relative; }

.rdtPicker { display: none; position: absolute; width: 240px; padding: 4px; margin-top: 1px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.1) 0px 1px 3px; border: 1px solid rgb(249, 249, 249); z-index: 99999 !important; }

.rdtPicker.is-mobile-year { width: 11.5rem; }

.rdtPicker.is-mobile-embed { width: 15rem; }

.rdtPickerNotDays { width: 192px; }

.rdtOpen .rdtPicker { display: block; }

.rdtStatic .rdtPicker { box-shadow: none; position: static; }

.rdtPicker .rdtTimeToggle { text-align: center; }

.rdtPicker table { width: 100%; margin: 0px; padding: 0px 12px; border-spacing: 0px 8px; border-collapse: inherit; }

.rdtMonths table, .rdtYears table { border-spacing: 0px 12px; }

.rdtMonths .headerTable, .rdtYears .headerTable { border-spacing: 0px; border-bottom: 1px solid var(--colors-neutral-line-8); }

.rdtPicker td, .rdtPicker th { text-align: center; height: 24px; line-height: 24px; width: 24px; }

.rdtPicker td { cursor: pointer; }

.rdtPicker td > span { display: inline-block; border-radius: var(--inputDate-default-option-top-left-border-radius) var(--inputDate-default-option-top-right-border-radius) var(--inputDate-default-option-bottom-right-border-radius) var(--inputDate-default-option-bottom-left-border-radius); height: 24px; width: 24px; }

.rdtPicker td.rdtDay:hover, .rdtPicker td.rdtHour:hover, .rdtPicker td.rdtMinute:hover, .rdtPicker td.rdtSecond:hover, .rdtPicker .rdtTimeToggle:hover { background: rgb(238, 238, 238); cursor: pointer; }

.rdtPicker td.rdtOld, .rdtPicker td.rdtNew { color: var(--inputDate-disabled-option-color); }

.rdtPicker td.rdtToday { position: relative; }

.rdtPicker td.rdtToday > span { border: 1px solid rgb(36, 104, 242); }

.rdtPicker td.rdtActive, .rdtPicker td.rdtActive:hover { background-color: rgb(66, 139, 202); color: rgb(255, 255, 255); text-shadow: rgba(0, 0, 0, 0.25) 0px -1px 0px; }

.rdtPicker td.rdtActive.rdtToday::before { border-bottom-color: rgb(255, 255, 255); }

.rdtPicker td.rdtDisabled, .rdtPicker td.rdtDisabled:hover { background: none; color: rgb(184, 186, 191); cursor: not-allowed; }

.rdtPicker td span.rdtOld { color: rgb(184, 186, 191); }

.rdtPicker td span.rdtDisabled, .rdtPicker td span.rdtDisabled:hover { background: none; color: rgb(184, 186, 191); cursor: not-allowed; }

.rdtPicker td span.rdtDisabled > span, .rdtPicker td span.rdtDisabled:hover > span { border-color: rgb(232, 233, 235); }

.rdtPicker th { border-bottom: 1px solid rgb(249, 249, 249); }

.rdtPicker .dow { width: 14.2857%; border-bottom: none; cursor: default; }

