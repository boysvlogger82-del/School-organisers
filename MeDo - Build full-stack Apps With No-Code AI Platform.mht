.Home .ChatWrapper { flex: 1 1 0%; position: relative; display: flex; flex-direction: column; align-items: center; z-index: 1; box-sizing: border-box; height: 100%; font-family: PingFangSC-Regular; transition: width 0.2s; }

@media (max-width: 1024px) {
  body.miaoda-mobile-container .Home .ChatWrapper { overflow: hidden; }
}

.Home .ChatWrapper.is-in-app { width: calc(30% - 16px); max-width: 820px; min-width: 360px; background: rgb(247, 249, 252); border-radius: 8px; }

.Home .ChatWrapper.is-hidden { width: 0px; min-width: 0px; }

.Home .ChatWrapper.is-collapsed { min-width: 0px; overflow: hidden; width: 0px !important; }

.Home .ChatWrapper.show-version > div:not(.VersionList-Container) { display: none; }

.Home:not(.in-app) .ChatUI-to-bottom { display: none; }

.Home:not(.in-app) .LuiChatBox-chat-item-content.is-robot { font-size: 16px; --content-line-height: 30px; }

.Home:not(.in-app) .LuiChatBox-chat-item-thumb.is-robot { --content-line-height: 30px; }

.Home.in-confirmQuire { background: rgb(247, 249, 252); }

@media (max-width: 1024px) {
  body.miaoda-mobile-container .Home.in-confirmQuire { height: calc(100% - var(--App-header-height)); overflow: hidden; }
}

@media (max-width: 1024px) {
  body.miaoda-mobile-container .Home.in-confirmQuire.is-miniapp { height: 100%; }
}

.Home.in-confirmQuire .Home-Main { height: var(--viewportHeight); padding: 4px 0px 12px; min-height: auto; max-height: none; }

@media (max-width: 1024px) {
  body.miaoda-mobile-container .Home.in-confirmQuire .Home-Main { height: 100%; padding: 0px; }
}

.Home.in-confirmQuire .LuiChatBox { min-height: auto !important; }

.Home.in-confirmQuire .LuiChatBox .ChatBox-chat-item:first-child .is-robot .ChatBox-chat-item-actions { margin-top: 12px; height: auto; opacity: 1 !important; }

.Home.in-confirmQuire .LuiChatBox-inner::before, .Home.in-confirmQuire .LuiChatBox-inner::after { height: 0px; min-height: 0px; }

.Home.in-confirmQuire .LuiChatBox-chat-item-history-divider { display: none; }

.Home.in-confirmQuire .cxd-ChatBox-feedback-popover { left: calc((100% - var(--main-max-width)) / 2 + var(--thumb-gap) + var(--thumb-size) - 6px) !important; }

.Home.in-app { height: 100%; overflow: hidden; min-width: 1280px; display: flex; flex-direction: column; }

@media (max-width: 1024px) {
  body.miaoda-mobile-container .Home.in-app { min-width: auto; }
}

