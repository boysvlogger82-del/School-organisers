@charset "utf-8";

.query-group { display: flex; flex-direction: row; gap: 0px; align-items: center; justify-content: flex-start; padding: 0px; font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif; }

.query-group-item { display: flex; align-items: center; position: relative; }

.query-group-link { font-size: 12px; font-weight: 400; line-height: 22px; color: rgb(132, 134, 140); text-decoration: none; cursor: pointer; transition: color 0.2s; white-space: nowrap; padding: 0px 8px; }

.query-group-link:hover { color: rgb(36, 104, 242); text-decoration: none; }

.query-group-link.active { color: rgb(21, 27, 38); }

.query-group-separator { width: 1px; height: 12px; background-color: rgb(232, 233, 235); margin: 0px 4px; display: inline-block; }

.link-modal .cxd-Modal-body, .link-modal .cxd-Modal-body .link-modal-form_url-input { margin: 10px 0px 0px; }

.richeditor.toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding: 8px; background-color: rgb(248, 249, 250); border-bottom: 1px solid rgb(222, 226, 230); min-height: 44px; border-radius: 8px 8px 0px 0px; }

.richeditor.toolbar .btn { padding: 4px 8px; font-size: 12px; line-height: 1.5; border: none; background: transparent; color: rgb(108, 117, 125); border-radius: 4px; transition: 0.2s ease-in-out; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 32px; }

.richeditor.toolbar .btn:hover, .richeditor.toolbar .btn:focus { background-color: rgb(233, 236, 239); color: rgb(73, 80, 87); }

.richeditor.toolbar .btn.is-active, .richeditor.toolbar .btn:active { background-color: rgb(73, 80, 87); color: rgb(255, 255, 255); }

.richeditor.toolbar .btn:disabled { opacity: 0.5; cursor: not-allowed; }

.richeditor.toolbar .btn i { font-size: 12px; }

.richeditor.toolbar .dropdown-menu { position: absolute; top: 100%; left: 0px; z-index: 1000; min-width: 120px; padding: 4px 0px; margin: 2px 0px 0px; font-size: 14px; color: rgb(33, 37, 41); text-align: left; background-color: rgb(255, 255, 255); background-clip: padding-box; border: 1px solid rgba(0, 0, 0, 0.15); border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.176) 0px 4px 16px; }

.richeditor.toolbar .dropdown-item { display: flex; align-items: center; gap: 8px; width: 100%; padding: 4px 12px; clear: both; font-weight: 400; color: rgb(33, 37, 41); text-decoration: none; white-space: nowrap; background-color: transparent; border: 0px; cursor: pointer; }

.richeditor.toolbar .dropdown-item:hover { background-color: rgb(233, 236, 239); color: rgb(73, 80, 87); }

.richeditor.toolbar .dropdown-item.active { background-color: rgb(73, 80, 87); color: rgb(255, 255, 255); }

.richeditor.toolbar .vr { width: 1px; height: 24px; background-color: rgb(222, 226, 230); margin: 0px 4px; align-self: center; }

.rich-editor > div > .ProseMirror { border: none !important; outline: none !important; box-shadow: none !important; }

.rich-editor > div > .ProseMirror ul, .rich-editor > div > .ProseMirror li { list-style: inherit !important; }

.rich-editor > div > .ProseMirror a { font-size: 100%; }

.rich-editor > div > .ProseMirror em { font-style: italic; }

.rich-editor > div > .ProseMirror ol { list-style: decimal !important; }

.rich-editor > div > .ProseMirror ol li { display: list-item; }

.rich-editor > div > .ProseMirror ul { list-style: disc !important; }

.rich-editor > div > .ProseMirror ul li { display: list-item; }

.tiptap { min-height: 400px; outline: none; padding: 2px 10px; }

.tiptap :first-child { margin-top: 0px; }

.tiptap .is-empty::before { content: attr(data-placeholder); float: left; pointer-events: none; height: 0px; font-size: 14px; color: rgb(184, 186, 191) !important; }

.rich-editor { margin: 0px auto; background-color: rgb(255, 255, 255); border-radius: 8px; transition: 0.2s ease-in-out; padding-bottom: 5px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; border: 1px solid rgb(212, 214, 217) !important; }

.rich-editor .toolbar { height: 32px !important; min-height: 32px !important; gap: 0px !important; padding: 0px 4px !important; margin: 0px !important; background: rgb(255, 255, 255) !important; }

.rich-editor:hover { border-color: rgb(132, 134, 140) !important; }

.rich-editor.rich-editor-focused { border-color: rgb(132, 134, 140) !important; color: rgb(21, 27, 38) !important; }

.rich-editor .ProseMirror, .rich-editor .ProseMirror-focused { outline: none !important; border: none !important; box-shadow: none !important; }

.rich-editor__toolbar { display: flex; flex-wrap: wrap; gap: 8px; padding: 16px; background-color: rgb(247, 250, 252); border-bottom: 1px solid rgb(212, 214, 217); }

.rich-editor__button { height: 28px; border: none; background: none; color: rgb(92, 95, 102); font-size: 12px; border-radius: 6px; cursor: pointer; transition: 0.2s; outline: none; padding: 0px 6px; }

.rich-editor__button.is-active { background-color: rgb(36, 104, 242); color: rgb(255, 255, 255); }

.rich-editor__file-input { display: none; }

.form-control.rich-editor, .form-control.rich-editor:focus { border: 1px solid rgb(226, 232, 240) !important; box-shadow: none !important; outline: 0px !important; padding: 0px !important; }

.ProseMirror span[style*="color"] { color: inherit !important; }

.ProseMirror mark.highlight { background-color: inherit !important; }

.ProseMirror .textStyle { color: inherit; }

.ProseMirror .highlight { padding: 0.2em; border-radius: 0.2em; }

.ProseMirror .highlight-yellow { background-color: rgb(255, 255, 0); }

.ProseMirror .highlight-pink { background-color: rgb(255, 204, 203); }

.ProseMirror .highlight-green { background-color: rgb(144, 238, 144); }

.ProseMirror .highlight-blue { background-color: rgb(173, 216, 230); }

.tiptap-icon-replaced { width: 20px !important; height: 20px !important; min-width: 20px !important; min-height: 20px !important; }

.tiptap-icon-replaced:hover { filter: brightness(0.8) saturate(1.2); }

