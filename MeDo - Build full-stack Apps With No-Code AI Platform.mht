}

.Home .Home-Main.is-full-screen { margin: 16px 16px 0px; }

.Home .Home-Main.is-full-screen .ViewWrapper { transition: width 0.2s; }

.Home .LuiChatBox-inner .LuiChatBox-Banner { margin-top: 194px; }

