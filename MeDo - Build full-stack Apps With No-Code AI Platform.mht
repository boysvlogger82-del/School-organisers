.Home .LuiChatBox-chat-list-inner { padding-left: 16px; padding-right: 16px; }

.Home .LuiChatBox-chat-list { margin-bottom: 0px; }

.Home .LuiChatBox-chat-list.is-hidden { flex: 0 1 0%; transition: none; }

.Home .LuiChatBox-prompt { background: rgb(255, 255, 255); }

.Home .LuiChatBox-prompt.is-hidden { height: 0px; opacity: 0; padding: 0px; overflow: hidden; transition: height var(--duration) var(--delay) linear,padding var(--duration) var(--delay) linear,opacity var(--duration) linear; }

.Home .LuiChatBox-chat-list-length-1:not(.no-child-animate) { --userDuration: .4s; --userDelay: calc(var(--duration) + var(--delay)); --robotDuration: .4s; --robotDelay: calc(var(--userDelay) + var(--userDuration)); }

.Home.with-transition .Home-Main { transition: padding var(--duration) var(--delay) linear,height var(--duration) var(--delay) linear; }

.Home.with-transition.in-confirmQuire { transition: background var(--duration) calc(var(--delay) + var(--duration)) linear; }

.Home.with-transition.in-app, .Home.with-transition.in-app .Home-Main { transition: none; }

.Home.with-transition.is-generating-app, .Home.with-transition.is-rewrite-prd { --duration: .5s; }

.Home.with-transition.is-generating-app .ChatWrapper, .Home.with-transition.is-rewrite-prd .ChatWrapper { opacity: 1; }

.Home.with-transition .LuiChatBox-user-input-toolbar { transition: height var(--duration) var(--delay) linear; }

.Home.with-transition .LuiChatBox-inner::before, .Home.with-transition .LuiChatBox-inner::after { transition: height var(--duration) var(--delay) linear; }

.Home.in-app { --duration: 0s; --delay: 0s; }

.Home.in-app .LuiChatBox-chat-list-length-1 { --userDuration: 0s; --userDelay: 0s; --robotDuration: 0s; --robotDelay: 0s; }

