.miaoda-pc-container { min-width: 1280px; overflow-x: auto; }

.Home { position: relative; width: 100%; --Editor-view-height: 40px; padding: 0px; }

.Home .Home-Header { position: relative; z-index: 9; }

.Home .Home-SwiperBanner { max-width: min(100%, 1804px); margin: 0px auto; padding: 0px 32px; display: flex; justify-content: flex-end; }

.Home .Home-SwiperBanner-container { position: absolute; z-index: 8; width: 100%; left: 50%; transform: translate(-50%); }

