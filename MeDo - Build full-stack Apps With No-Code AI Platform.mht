.Home .Home-SwiperBanner .swiper-banner-wrapper { margin-right: 0px; margin-top: 24px; }

@media (min-width: 1920px) and (max-width: 2004px) {
  .Home .Home-SwiperBanner { width: 1804px; }
}

@media (min-width: 2005px) {
  .Home .Home-SwiperBanner { max-width: min(100%, 1770px); padding-right: 0px; }
}

.Home .Home-Main { flex: 1 1 0%; display: flex; align-items: center; min-height: 536px; max-height: 600px; z-index: 5; position: relative; }

.Home .Home-Main.gap-16 { gap: 16px; }

